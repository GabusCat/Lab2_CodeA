void delay_ms(uint16_t ms) {
    while (ms--) {
        __delay_ms(1);
    }
}

// =============================================================================
// ADC
// =============================================================================
void adc_init(void) {
    // AN0 y AN1 analogicos, resto digital
    ANSEL  = 0x03;   // AN0 y AN1
    ANSELH = 0x00;
    // RA0, RA1 como entradas
    TRISAbits.TRISA0 = 1;
    TRISAbits.TRISA1 = 1;
    // Configurar ADC: Fosc/64 (valido para 8 MHz), justificacion derecha, Vref=VDD
    // ADCS2:ADCS1:ADCS0 = 1:1:0 → Fosc/64
    // ADCS2 = ADCON0<7>, ADCS1 = ADCON0<6>, ADCS0 = ADCON1<6>
    ADCON0 = 0xC0;   // ADCS2=1, ADCS1=1, canal=0, ADC apagado
    ADCON1 = 0x00;   // ADCS0=0, Vref+=VDD, Vref-=VSS, justif derecha
    ADCON0bits.ADON = 1;
}

uint16_t adc_leer(uint8_t canal) {
    ADCON0bits.CHS = canal & 0x0F;  // seleccionar canal
    __delay_us(20);                  // tiempo de adquisicion
    ADCON0bits.GO = 1;
    while (ADCON0bits.GO);           // esperar conversion
    return ((uint16_t)ADRESH << 8) | ADRESL;
}

// =============================================================================
// I2C SOFTWARE (BIT-BANGING) para LCD
// =============================================================================
void i2c_delay(void) {
    __delay_us(5);  // ~100 kHz
}

void i2c_init(void) {
    SCL_TRIS = 1;  // open-drain: controlar via TRIS
    SDA_TRIS = 1;
    SCL_PIN  = 0;
    SDA_PIN  = 0;
    PORTC &= ~0x18; // RC3, RC4 en 0 (cuando se pongan como salida iran a bajo)
}

void i2c_start(void) {
    SDA_TRIS = 0; SDA_PIN = 1; i2c_delay();
    SCL_TRIS = 0; SCL_PIN = 1; i2c_delay();
    SDA_PIN  = 0; i2c_delay();
    SCL_PIN  = 0; i2c_delay();
}

void i2c_stop(void) {
    SDA_PIN  = 0; i2c_delay();
    SCL_PIN  = 1; i2c_delay();
    SDA_PIN  = 1; i2c_delay();
}

void i2c_write_byte(uint8_t dato) {
    uint8_t i;
    for (i = 0; i < 8; i++) {
        if (dato & 0x80) { SDA_PIN = 1; } else { SDA_PIN = 0; }
        i2c_delay();
        SCL_PIN = 1; i2c_delay();
        SCL_PIN = 0; i2c_delay();
        dato <<= 1;
    }
    // ACK: liberar SDA y dar pulso de reloj
    SDA_TRIS = 1; i2c_delay();
    SCL_PIN  = 1; i2c_delay();
    SCL_PIN  = 0; i2c_delay();
    SDA_TRIS = 0;
}

// =============================================================================
// LCD HD44780 via PCF8574 (I2C)
// =============================================================================
void lcd_pulsar_enable(uint8_t dato) {
    i2c_start();
    i2c_write_byte(LCD_ADDR << 1);
    i2c_write_byte(dato | LCD_EN | LCD_BACKLIGHT);
    i2c_stop();
    __delay_us(1);
    i2c_start();
    i2c_write_byte(LCD_ADDR << 1);
    i2c_write_byte((dato & ~LCD_EN) | LCD_BACKLIGHT);
    i2c_stop();
    __delay_us(50);
}

void lcd_enviar_nibble(uint8_t nibble, uint8_t rs) {
    uint8_t dato = ((nibble & 0x0F) << 4) | (rs ? LCD_RS : 0);
    lcd_pulsar_enable(dato);
}

void lcd_cmd(uint8_t cmd) {
    lcd_enviar_nibble(cmd >> 4, 0);
    lcd_enviar_nibble(cmd & 0x0F, 0);
    if (cmd == 0x01 || cmd == 0x02) delay_ms(2);
    else __delay_us(50);
}

void lcd_data(uint8_t dato) {
    lcd_enviar_nibble(dato >> 4, 1);
    lcd_enviar_nibble(dato & 0x0F, 1);
    __delay_us(50);
}

void lcd_init(void) {
    delay_ms(50);
    // Secuencia de inicializacion en modo 4 bits
    lcd_enviar_nibble(0x03, 0); delay_ms(5);
    lcd_enviar_nibble(0x03, 0); __delay_us(150);
    lcd_enviar_nibble(0x03, 0); __delay_us(150);
    lcd_enviar_nibble(0x02, 0); __delay_us(150);
    // Configuracion
    lcd_cmd(0x28); // 4 bits, 2 lineas, 5x8
    lcd_cmd(0x0C); // display on, cursor off
    lcd_cmd(0x06); // incremento automatico
    lcd_cmd(0x01); // clear
    delay_ms(2);
}

void lcd_goto(uint8_t fila, uint8_t col) {
    uint8_t addr = (fila == 0) ? 0x80 : 0xC0;
    lcd_cmd(addr + col);
}

void lcd_print(const char *str) {
    while (*str) {
        lcd_data((uint8_t)*str);
        str++;
    }
}

void lcd_print_line(uint8_t linea, const char *str) {
    char buf[17];
    uint8_t len, i;
    len = strlen(str);
    if (len > 16) len = 16;
    for (i = 0; i < len; i++) buf[i] = str[i];
    // rellenar con espacios
    for (i = len; i < 16; i++) buf[i] = ' ';
    buf[16] = '\0';
    lcd_goto(linea, 0);
    lcd_print(buf);
}

void lcd_clear(void) {
    lcd_cmd(0x01);
    delay_ms(2);
}

// =============================================================================
// TECLADO MATRICIAL 4x4 (PORTD: filas=RD0-3, columnas=RD4-7)
// Layout:
//   F\C  C0(RD4) C1(RD5) C2(RD6) C3(RD7)
//   F0(RD0)  1       2       3       A
//   F1(RD1)  4       5       6       B
//   F2(RD2)  7       8       9       C
//   F3(RD3)  *       0       #       D
// Logica: fila va a 0, columna detecta 0 si hay tecla presionada
// =============================================================================
const char mapa_teclado[4][4] = {
    {'1', '2', '3', 'A'},
    {'4', '5', '6', 'B'},
    {'7', '8', '9', 'C'},
    {'*', '0', '#', 'D'}
};

char teclado_leer(void) {
    uint8_t fila, col, col_val;
    for (fila = 0; fila < 4; fila++) {
        // Poner fila actual en BAJO, resto en ALTO
        TECLADO_PORT = (TECLADO_PORT | FILAS_MASK);  // todas filas en 1
        TECLADO_PORT &= ~(1 << fila);                 // fila activa en 0
        __delay_us(10);
        col_val = (TECLADO_PORT >> 4) & 0x0F;         // leer columnas (RD4-RD7)
        // col_val: bit=0 significa tecla presionada (pull-up externo + fila en bajo)
        for (col = 0; col < 4; col++) {
            if (!(col_val & (1 << col))) {
                delay_ms(20);  // debounce
                // verificar que sigue presionada
                col_val = (TECLADO_PORT >> 4) & 0x0F;
                if (!(col_val & (1 << col))) {
                    // esperar que la suelte
                    TECLADO_PORT = (TECLADO_PORT | FILAS_MASK);
                    return mapa_teclado[fila][col];
                }
            }
        }
    }
    TECLADO_PORT = (TECLADO_PORT | FILAS_MASK);  // dejar filas en ALTO
    return 0;
}

char teclado_esperar(void) {
    char tecla;
    do { tecla = teclado_leer(); } while (tecla == 0);
    return tecla;
}

// =============================================================================
// BUZZER (PWM por software en RC1)
// =============================================================================
void buzzer_tono(uint16_t freq_hz, uint16_t duracion_ms) {
    uint32_t periodo_us, mitad_us;
    uint32_t ciclos;
    uint32_t i;
    if (freq_hz == 0) { buzzer_off(); delay_ms(duracion_ms); return; }
    periodo_us = 1000000UL / freq_hz;
    mitad_us   = periodo_us / 2;
    ciclos     = ((uint32_t)freq_hz * duracion_ms) / 1000UL;
    for (i = 0; i < ciclos; i++) {
        BUZZER_PIN = 1;
        // delay en microsegundos usando bucle (aprox)
        { uint16_t d = (uint16_t)mitad_us; while (d--) __delay_us(1); }
        BUZZER_PIN = 0;
        { uint16_t d = (uint16_t)mitad_us; while (d--) __delay_us(1); }
    }
}

void buzzer_off(void) { BUZZER_PIN = 0; }

void buzzer_click(void) {
    // Click corto 500 Hz, 80 ms
    buzzer_tono(500, 80);
}

void buzzer_correcto(void) {
    // Tono 1kHz por 1 segundo al acertar digito
    buzzer_tono(1000, 1000);
}

void buzzer_victoria(void) {
    // Tono de victoria: secuencia ascendente
    buzzer_tono(1000, 150); delay_ms(50);
    buzzer_tono(1500, 150); delay_ms(50);
    buzzer_tono(2000, 500);
}

void buzzer_beep_corto(void) {
    buzzer_tono(800, 100);
}

// =============================================================================
// MATRIZ DE LEDS 5x5
// Filas: RE0,RE1,RE2,RA6,RA7   Columnas: RB0-RB4
// Activo en ALTO (transistores NPN como switches)
// =============================================================================
// Apaga todas las filas y columnas
void matriz_fila_set(uint8_t fila, uint8_t val) {
    switch (fila) {
        case 0: RE0 = val; break;
        case 1: RE1 = val; break;
        case 2: RE2 = val; break;
        case 3: RA6 = val; break;
        case 4: RA7 = val; break;
    }
}

void matriz_apagar(void) {
    RE0 = 0; RE1 = 0; RE2 = 0; RA6 = 0; RA7 = 0;
    PORTB = (PORTB & 0xE0);  // RB0-RB4 en 0
    uint8_t i;
    for (i = 0; i < 5; i++) frame_mat[i] = 0;
}

void matriz_encender_todo(void) {
    uint8_t i;
    for (i = 0; i < 5; i++) frame_mat[i] = 0x1F;  // 5 columnas activas
}

void matriz_set_led(uint8_t fila, uint8_t col, uint8_t on) {
    if (fila > 4 || col > 4) return;
    if (on) frame_mat[fila] |=  (1 << col);
    else    frame_mat[fila] &= ~(1 << col);
}

// Refresco manual de una fila (llamar en bucle principal si no hay ISR)
// Se llama con delay_ms pequeño entre filas para multiplexacion
void matriz_refresh_manual(void) {
    uint8_t f;
    for (f = 0; f < 5; f++) {
        // Apagar todas las filas primero
        RE0 = 0; RE1 = 0; RE2 = 0; RA6 = 0; RA7 = 0;
        // Poner columnas segun frame
        PORTB = (PORTB & 0xE0) | (frame_mat[f] & 0x1F);
        // Activar fila
        matriz_fila_set(f, 1);
        __delay_us(500);  // ~500us por fila → ~10 ms total → ~100 Hz refresh
    }
    // Apagar al final
    RE0 = 0; RE1 = 0; RE2 = 0; RA6 = 0; RA7 = 0;
}

// Refresco de matriz durante duracion_ms milisegundos sin bloquear otras operaciones
// (no hay ISR, se hace polling del frame dentro del tiempo indicado)
void matriz_mostrar_ms(uint16_t ms) {
    uint16_t ciclos = ms / 10;  // cada ciclo ~10 ms (5 filas x ~2 ms)
    uint16_t i;
    for (i = 0; i < ciclos; i++) {
        matriz_refresh_manual();
        __delay_ms(5);
    }
}

