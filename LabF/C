void leds_etapa_apagar_todos(void) {
    LED1_PIN = 0;
    LED2_PIN = 0;
    LED3_PIN = 0;
    LED4_PIN = 0;
}

void leds_etapa_actualizar(void) {
    LED1_PIN = etapa_ok[0];
    LED2_PIN = etapa_ok[1];
    LED3_PIN = etapa_ok[2];
    LED4_PIN = etapa_ok[3];
}

// =============================================================================
// REVELACION PROGRESIVA EN LCD LINEA 2
// Muestra: digito si etapa_ok, '*' si no
// contrasena[0] y [1] son las decenas/unidades del numero 2 cifras
// =============================================================================
void mostrar_revelacion(void) {
    char buf[5];
    buf[0] = etapa_ok[0] ? ('0' + contrasena[0]) : '*';
    buf[1] = etapa_ok[1] ? ('0' + contrasena[1]) : '*';
    buf[2] = etapa_ok[2] ? ('0' + contrasena[2]) : '*';
    buf[3] = etapa_ok[3] ? ('0' + contrasena[3]) : '*';
    buf[4] = '\0';
    // Centrar en 16 caracteres
    lcd_print_line(1, buf);
}

// =============================================================================
// RESET COMPLETO DEL SISTEMA
// =============================================================================
void reset_sistema(void) {
    uint8_t i;
    for (i = 0; i < 4; i++) { contrasena[i] = 0; etapa_ok[i] = 0; }
    leds_etapa_apagar_todos();
    matriz_apagar();
    estado_actual = EST_ESPERA_INICIO;
}

// =============================================================================
// INICIALIZACION DEL SISTEMA
// =============================================================================
void sistema_init(void) {
    // Oscilador interno 8 MHz
    OSCCONbits.IRCF = 0b111;  // 8 MHz
    OSCCONbits.SCS  = 1;

    // --- PORTA ---
    // RA0, RA1: analogicos (ADC) — ANSEL ya configurado en adc_init
    // RA2-RA5: entradas digitales (switches)
    // RA6, RA7: salidas digitales (filas 3 y 4 de la matriz)
    TRISA = 0b00111111;   // RA0-RA5 entradas, RA6-RA7 salidas
    PORTA = 0x00;

    // --- PORTB ---
    // RB0-RB4: columnas de la matriz (salidas)
    // RB5-RB7: libre
    TRISB = 0xE0;   // RB0-RB4 salidas, RB5-RB7 entradas
    PORTB = 0x00;

    // --- PORTC ---
    // RC0: LED1, RC1: Buzzer, RC3: SCL, RC4: SDA, RC5: LED2, RC6: LED3, RC7: LED4
    TRISC = 0b00011000;   // RC3, RC4 se manejan como open-drain en I2C
    PORTC = 0x00;

    // --- PORTD ---
    // RD0-RD3: filas teclado (salidas), RD4-RD7: columnas teclado (entradas)
    TRISD = 0xF0;   // RD0-RD3 salidas, RD4-RD7 entradas
    PORTD = 0xFF;   // filas en ALTO inicialmente (pull-up externo en columnas)

    // --- PORTE ---
    // RE0, RE1, RE2: filas 0,1,2 de la matriz (salidas)
    TRISE = 0x00;   // RE0-RE2 como salidas, deshabilitar ADC en PORTE
    PORTE = 0x00;

    // Deshabilitar comparadores
    CM1CON0 = 0x00;
    CM2CON0 = 0x00;

    // ADC init
    adc_init();

    // I2C init
    i2c_init();

    // LCD init
    lcd_init();

    // Buzzer apagado
    BUZZER_TRIS = 0;
    BUZZER_PIN  = 0;

    // LEDs apagados
    LED1_TRIS = 0; LED2_TRIS = 0; LED3_TRIS = 0; LED4_TRIS = 0;
    leds_etapa_apagar_todos();

    // Matriz apagada
    TRISE &= ~0x07;  // RE0-RE2 salidas (ya hecho)
    PORTA &= ~0xC0;  // RA6, RA7 en 0
    matriz_apagar();

    // Reset variables
    reset_sistema();
    estado_actual = EST_ESPERA_INICIO;
}

// =============================================================================
// ESTADO 0 — ESPERA INICIO
// =============================================================================
void estado_espera_inicio(void) {
    lcd_print_line(0, "  CAJA FUERTE   ");
    lcd_print_line(1, " Programe clave ");
    delay_ms(2000);
    estado_actual = EST_PROG_CLAVE;
}

// =============================================================================
// ESTADO 1 — PROGRAMACION DE CONTRASENA
// =============================================================================
void estado_prog_clave(void) {
    uint8_t digitos_ingresados = 0;
    uint8_t digitos[4];
    uint8_t i;
    char tecla;
    uint16_t tick = 0;
    uint8_t led_estado = 0;
    char buf_asteriscos[5] = "    ";

    // Limpiar
    for (i = 0; i < 4; i++) digitos[i] = 0xFF;  // 0xFF = no ingresado
    lcd_print_line(0, "Ingrese clave:  ");
    lcd_print_line(1, "                ");

    while (1) {
        // Parpadeo LEDs indicadores cada 1 segundo
        tick++;
        if (tick >= 50) {  // ~50 * 20ms = 1 segundo
            tick = 0;
            led_estado ^= 1;
            LED1_PIN = led_estado;
            LED2_PIN = led_estado;
            LED3_PIN = led_estado;
            LED4_PIN = led_estado;
        }

        tecla = teclado_leer();
        if (tecla == 0) { delay_ms(20); continue; }

        // Tecla letra (A, B, C, D) — mostrar error
        if (tecla == 'A' || tecla == 'B' || tecla == 'C' || tecla == 'D') {
            lcd_print_line(0, "  UN NUMERO     ");
            lcd_print_line(1, "  NO LETRA      ");
            delay_ms(1000);
            lcd_print_line(0, "Ingrese clave:  ");
            // Reconstruir asteriscos
            buf_asteriscos[0] = '\0';
            for (i = 0; i < digitos_ingresados; i++) buf_asteriscos[i] = '*';
            buf_asteriscos[digitos_ingresados] = '\0';
            lcd_print_line(1, buf_asteriscos);
            delay_ms(20);
            continue;
        }

        // Borrar ultimo digito
        if (tecla == '*') {
            if (digitos_ingresados > 0) {
                digitos_ingresados--;
                digitos[digitos_ingresados] = 0xFF;
                // Actualizar asteriscos
                for (i = 0; i < 4; i++) buf_asteriscos[i] = ' ';
                buf_asteriscos[4] = '\0';
                for (i = 0; i < digitos_ingresados; i++) buf_asteriscos[i] = '*';
                lcd_print_line(1, buf_asteriscos);
            }
            delay_ms(20);
            continue;
        }

        // Confirmar con #
        if (tecla == '#') {
            if (digitos_ingresados == 4) {
                // Guardar contrasena
                contrasena[0] = digitos[0];
                contrasena[1] = digitos[1];
                contrasena[2] = digitos[2];
                contrasena[3] = digitos[3];
                leds_etapa_apagar_todos();
                lcd_print_line(0, "Clave guardada! ");
                lcd_print_line(1, "                ");
                delay_ms(1000);
                // Esperar que SW1 suba
                lcd_print_line(0, "Suba switch 1   ");
                lcd_print_line(1, "para continuar  ");
                while (!SW1);
                delay_ms(50);  // debounce switch
                estado_actual = EST_VAL_SUMA;
                return;
            }
            delay_ms(20);
            continue;
        }

        // Digito numerico (0-9)
        if (tecla >= '0' && tecla <= '9' && digitos_ingresados < 4) {
            digitos[digitos_ingresados] = tecla - '0';
            digitos_ingresados++;
            // Actualizar asteriscos en pantalla
            for (i = 0; i < digitos_ingresados; i++) buf_asteriscos[i] = '*';
            buf_asteriscos[digitos_ingresados] = '\0';
            lcd_print_line(1, buf_asteriscos);
        }

        delay_ms(20);
    }
}

// =============================================================================
// ESTADO 2 — VALIDACION SUMA (digitos 1 y 2)
// =============================================================================
void estado_val_suma(void) {
    uint8_t objetivo = contrasena[0] * 10 + contrasena[1];
    uint16_t num1 = 0, num2 = 0;
    uint8_t paso = 0;           // 0 = ingresando num1, 1 = ingresando num2
    uint8_t digitos_num = 0;    // cuantos digitos lleva el numero actual
    char tecla;
    char buf[17];
    uint8_t correcto = 0;

    // Verificar condicion de switch
    if (switches_leer() != 0x01) { estado_actual = EST_PROG_CLAVE; return; }

    lcd_print_line(0, "N1:   N2:       ");
    mostrar_revelacion();

    while (!correcto) {
        // Verificar switch
        if (switches_leer() != 0x01) return;

        num1 = 0; num2 = 0; paso = 0; digitos_num = 0;
        lcd_print_line(0, "N1:__ N2:__     ");
        mostrar_revelacion();

        // --- Ingreso num1 ---
        while (paso == 0) {
            if (switches_leer() != 0x01) return;
            tecla = teclado_leer();
            if (tecla == 0) { delay_ms(20); continue; }

            if (tecla >= '0' && tecla <= '9' && digitos_num < 2) {
                num1 = num1 * 10 + (tecla - '0');
                digitos_num++;
                snprintf(buf, 17, "N1:%02u N2:__     ", (unsigned)num1);
                lcd_print_line(0, buf);
            } else if (tecla == '*' && digitos_num > 0) {
                // Borrar: recalcular quitando ultimo digito
                num1 /= 10;
                digitos_num--;
                snprintf(buf, 17, "N1:%02u N2:__     ", (unsigned)num1);
                lcd_print_line(0, buf);
            } else if (tecla == 'A' && digitos_num > 0) {
                paso = 1;
                digitos_num = 0;
            }
            delay_ms(20);
        }

        // --- Ingreso num2 ---
        while (paso == 1) {
            if (switches_leer() != 0x01) return;
            tecla = teclado_leer();
            if (tecla == 0) { delay_ms(20); continue; }

            if (tecla >= '0' && tecla <= '9' && digitos_num < 2) {
                num2 = num2 * 10 + (tecla - '0');
                digitos_num++;
                snprintf(buf, 17, "N1:%02u N2:%02u     ", (unsigned)num1, (unsigned)num2);
                lcd_print_line(0, buf);
            } else if (tecla == '*' && digitos_num > 0) {
                num2 /= 10;
                digitos_num--;
                snprintf(buf, 17, "N1:%02u N2:%02u     ", (unsigned)num1, (unsigned)num2);
                lcd_print_line(0, buf);
            } else if (tecla == 'A' && digitos_num > 0) {
                // Evaluar suma
                uint16_t suma = num1 + num2;
                if (suma == objetivo) {
                    // Correcto!
                    etapa_ok[0] = 1;
                    etapa_ok[1] = 1;
                    leds_etapa_actualizar();
                    lcd_print_line(0, "Correcto!       ");
                    mostrar_revelacion();
                    buzzer_correcto();
                    // Esperar SW2
                    lcd_print_line(0, "Suba switch 2   ");
                    while (!SW2);
                    delay_ms(50);
                    correcto = 1;
                    paso = 2;  // salir del bucle interno
                } else if (suma > objetivo) {
                    lcd_print_line(0, "Muy alto!       ");
                    mostrar_revelacion();
                    delay_ms(1500);
                    paso = 2;  // reintentar
                } else {
                    lcd_print_line(0, "Muy bajo!       ");
                    mostrar_revelacion();
                    delay_ms(1500);
                    paso = 2;  // reintentar
                }
            }
            delay_ms(20);
        }
    }

    estado_actual = EST_VAL_POT1;
}

// =============================================================================
// ESTADO 3 — VALIDACION POT1 (digito 3)
// =============================================================================
void estado_val_pot1(void) {
    uint16_t adc_val;
    uint8_t digito_actual;
    uint8_t correcto = 0;
    char buf[17];

    if (switches_leer() != 0x03) { estado_actual = EST_VAL_SUMA; return; }

    while (!correcto) {
        if (switches_leer() != 0x03) return;

        adc_val = adc_leer(ADC_POT1);
        digito_actual = (uint8_t)((uint32_t)adc_val * 10 / 1024);
        if (digito_actual > 9) digito_actual = 9;

        // Retroalimentacion
        if (digito_actual < contrasena[2]) {
            snprintf(buf, 17, "POT1:%d Sube    ", digito_actual);
        } else if (digito_actual > contrasena[2]) {
            snprintf(buf, 17, "POT1:%d Baja    ", digito_actual);
        } else {
            snprintf(buf, 17, "POT1:%d OK!     ", digito_actual);
        }
        lcd_print_line(0, buf);
        mostrar_revelacion();

        if (digito_actual == contrasena[2]) {
            // Correcto
            etapa_ok[2] = 1;
            leds_etapa_actualizar();
            buzzer_click();
            lcd_print_line(0, "POT1 correcto!  ");
            mostrar_revelacion();
            // Esperar SW3
            lcd_print_line(0, "Suba switch 3   ");
            while (!SW3);
            delay_ms(50);
            correcto = 1;
        }
        delay_ms(100);
    }

    estado_actual = EST_VAL_POT2;
}

// =============================================================================
// ESTADO 4 — VALIDACION POT2 (digito 4)
// =============================================================================
void estado_val_pot2(void) {
    uint16_t adc_val;
    uint8_t digito_actual;
    uint8_t correcto = 0;
    char buf[17];

    if (switches_leer() != 0x07) { estado_actual = EST_VAL_POT1; return; }

    while (!correcto) {
        if (switches_leer() != 0x07) return;

        adc_val = adc_leer(ADC_POT2);
        digito_actual = (uint8_t)((uint32_t)adc_val * 10 / 1024);
        if (digito_actual > 9) digito_actual = 9;

        if (digito_actual < contrasena[3]) {
            snprintf(buf, 17, "POT2:%d Sube    ", digito_actual);
        } else if (digito_actual > contrasena[3]) {
            snprintf(buf, 17, "POT2:%d Baja    ", digito_actual);
        } else {
            snprintf(buf, 17, "POT2:%d OK!     ", digito_actual);
        }
        lcd_print_line(0, buf);
        mostrar_revelacion();

        if (digito_actual == contrasena[3]) {
            etapa_ok[3] = 1;
            leds_etapa_actualizar();
            buzzer_click();
            lcd_print_line(0, "POT2 correcto!  ");
            mostrar_revelacion();
            delay_ms(800);

            // Verificar si todas las etapas estan completas
            if (etapa_ok[0] && etapa_ok[1] && etapa_ok[2] && etapa_ok[3]) {
                lcd_print_line(0, "** ABIERTO! **  ");
                mostrar_revelacion();
                buzzer_correcto();
                delay_ms(1000);
                // Esperar SW4
                lcd_print_line(0, "Suba switch 4   ");
                lcd_print_line(1, "para jugar Pong ");
                while (!SW4);
                delay_ms(50);
                correcto = 1;
            } else {
                // Alguna etapa falta — "Pobre pelao"
                uint8_t t;
                for (t = 0; t < 6; t++) {
                    if (t % 2 == 0) lcd_print_line(0, "Pobre pelao     ");
                    else            lcd_print_line(0, "te falta rey    ");
                    mostrar_revelacion();
                    delay_ms(1000);
                }
                // Volver a esperar correcto en pot2 (no se puede avanzar)
                // etapa_ok[3] se mantiene si ya fue correcto el pot2
                // pero si faltan etapas anteriores no se avanza
                correcto = 0;  // mantener en este estado para mostrar mensaje
                // forzar salida del while para reiniciar feedback
            }
        }
        delay_ms(100);
    }

    estado_actual = EST_PONG;
}

// =============================================================================
// ESTADO 5 — JUEGO PONG
// =============================================================================

// Estructuras del juego
typedef struct {
    int8_t x, y;    // posicion pelota (0-4)
    int8_t dx, dy;  // direccion pelota
} Pelota;

typedef struct {
    int8_t pos;     // posicion superior de la paleta (0-3, ocupa pos y pos+1)
} Paleta;

void pong_dibujar(Pelota *p, Paleta *pal_izq, Paleta *pal_der) {
    uint8_t f, c;
    // Limpiar frame
    for (f = 0; f < 5; f++) frame_mat[f] = 0;

    // Dibujar paleta izquierda en col 0
    for (f = 0; f < 5; f++) {
        if (f == (uint8_t)pal_izq->pos || f == (uint8_t)(pal_izq->pos + 1)) {
            frame_mat[f] |= (1 << 0);  // col 0
        }
    }

    // Dibujar paleta derecha en col 4
    for (f = 0; f < 5; f++) {
        if (f == (uint8_t)pal_der->pos || f == (uint8_t)(pal_der->pos + 1)) {
            frame_mat[f] |= (1 << 4);  // col 4
        }
    }

    // Dibujar pelota
    if (p->x >= 0 && p->x <= 4 && p->y >= 0 && p->y <= 4) {
        frame_mat[(uint8_t)p->y] |= (1 << (uint8_t)p->x);
    }
}

void estado_pong(void) {
    Pelota pelota;
    Paleta pal_izq, pal_der;
    uint8_t score1 = 0, score2 = 0;
    uint16_t velocidad = 300;  // ms por paso
    uint16_t adc_val;
    char buf[17];
    uint16_t tick_vel;
    uint8_t gano = 0;

    if (switches_leer() != 0x0F) { estado_actual = EST_VAL_POT2; return; }

    // LEDs indicadores apagados durante el juego
    leds_etapa_apagar_todos();

    // Inicializar pelota
    pelota.x = 2; pelota.y = 2; pelota.dx = 1; pelota.dy = 1;
    pal_izq.pos = 1;
    pal_der.pos = 1;

    lcd_print_line(0, "J1:0    J2:0    ");
    lcd_print_line(1, "   PONG READY   ");
    delay_ms(1500);

    while (!gano) {
        if (switches_leer() != 0x0F) return;

        // Leer potenciometros → posicion paletas
        adc_val = adc_leer(ADC_POT1);
        pal_izq.pos = (int8_t)((uint32_t)adc_val * 4 / 1024);
        if (pal_izq.pos > 3) pal_izq.pos = 3;

        adc_val = adc_leer(ADC_POT2);
        pal_der.pos = (int8_t)((uint32_t)adc_val * 4 / 1024);
        if (pal_der.pos > 3) pal_der.pos = 3;

        // Dibujar y refrescar mientras pasa el tiempo de velocidad
        pong_dibujar(&pelota, &pal_izq, &pal_der);
        for (tick_vel = 0; tick_vel < velocidad / 10; tick_vel++) {
            // Actualizar paletas en cada ciclo de refresco
            adc_val = adc_leer(ADC_POT1);
            pal_izq.pos = (int8_t)((uint32_t)adc_val * 4 / 1024);
            if (pal_izq.pos > 3) pal_izq.pos = 3;
            adc_val = adc_leer(ADC_POT2);
            pal_der.pos = (int8_t)((uint32_t)adc_val * 4 / 1024);
            if (pal_der.pos > 3) pal_der.pos = 3;
            pong_dibujar(&pelota, &pal_izq, &pal_der);
            matriz_refresh_manual();
            delay_ms(10);
        }

        // Mover pelota
        pelota.x += pelota.dx;
        pelota.y += pelota.dy;

        // Rebote bordes superior/inferior
        if (pelota.y <= 0) { pelota.y = 0; pelota.dy = 1;  buzzer_tono(400, 50); velocidad -= 5; if (velocidad < 20) velocidad = 20; }
        if (pelota.y >= 4) { pelota.y = 4; pelota.dy = -1; buzzer_tono(400, 50); velocidad -= 5; if (velocidad < 20) velocidad = 20; }

        // Rebote paleta izquierda (col 0)
        if (pelota.x <= 0) {
            pelota.x = 0;
            if (pelota.y == pal_izq.pos || pelota.y == pal_izq.pos + 1) {
                pelota.dx = 1;
                buzzer_tono(800, 50);
                velocidad -= 5; if (velocidad < 20) velocidad = 20;
            } else {
                // Punto para J2
                score2++;
                snprintf(buf, 17, "J1:%d    J2:%d    ", score1, score2);
                lcd_print_line(0, buf);
                buzzer_tono(1200, 200);
                if (score2 >= 5) { gano = 2; break; }
                // Reiniciar pelota hacia izquierda (hacia el que anoto)
                pelota.x = 2; pelota.y = 2; pelota.dx = -1; pelota.dy = 1;
                velocidad = 300;
                delay_ms(800);
            }
        }

        // Rebote paleta derecha (col 4)
        if (pelota.x >= 4) {
            pelota.x = 4;
            if (pelota.y == pal_der.pos || pelota.y == pal_der.pos + 1) {
                pelota.dx = -1;
                buzzer_tono(800, 50);
                velocidad -= 5; if (velocidad < 20) velocidad = 20;
            } else {
                // Punto para J1
                score1++;
                snprintf(buf, 17, "J1:%d    J2:%d    ", score1, score2);
                lcd_print_line(0, buf);
                buzzer_tono(1200, 200);
                if (score1 >= 5) { gano = 1; break; }
                // Reiniciar pelota hacia derecha
                pelota.x = 2; pelota.y = 2; pelota.dx = 1; pelota.dy = 1;
                velocidad = 300;
                delay_ms(800);
            }
        }
    }

    // Animacion de victoria
    if (gano == 1) lcd_print_line(0, "GANADOR J1!     ");
    else           lcd_print_line(0, "GANADOR J2!     ");
    snprintf(buf, 17, "J1:%d    J2:%d    ", score1, score2);
    lcd_print_line(1, buf);

    buzzer_victoria();

    // Parpadeo matriz 3 veces rapido
    uint8_t k;
    for (k = 0; k < 6; k++) {
        if (k % 2 == 0) matriz_encender_todo();
        else            matriz_apagar();
        delay_ms(300);
    }
    matriz_apagar();

    estado_actual = EST_ESPERA_RESET;
}

// =============================================================================
// ESTADO 6 — ESPERA RESET
// =============================================================================
void estado_espera_reset(void) {
    uint8_t mat_on = 0;
    uint16_t tick = 0;

    lcd_print_line(0, "Baje switches   ");
    lcd_print_line(1, "para reiniciar  ");
    matriz_apagar();

    while (switches_leer() != 0x00) {
        // Parpadeo matriz cada 1 segundo
        tick++;
        if (tick >= 50) {  // 50 * 20ms = 1 seg
            tick = 0;
            mat_on ^= 1;
            if (mat_on) { matriz_encender_todo(); buzzer_beep_corto(); }
            else        { matriz_apagar(); }
        }
        // Refrescar si esta encendida
        if (mat_on) matriz_refresh_manual();
        delay_ms(20);
    }

    // Todos los switches bajados
    delay_ms(100);  // debounce
    matriz_apagar();
    reset_sistema();
    estado_actual = EST_ESPERA_INICIO;
}

// =============================================================================
// LOOP PRINCIPAL DE ESTADOS
// =============================================================================
void loop_estados(void) {
    switch (estado_actual) {
        case EST_ESPERA_INICIO:  estado_espera_inicio(); break;
        case EST_PROG_CLAVE:     estado_prog_clave();    break;
        case EST_VAL_SUMA:       estado_val_suma();      break;
        case EST_VAL_POT1:       estado_val_pot1();      break;
        case EST_VAL_POT2:       estado_val_pot2();      break;
        case EST_PONG:           estado_pong();          break;
        case EST_ESPERA_RESET:   estado_espera_reset();  break;
        default:                 estado_actual = EST_ESPERA_INICIO; break;
    }
}

// =============================================================================
// MAIN
// =============================================================================
void main(void) {
    sistema_init();
    while (1) {
        loop_estados();
    }
}
